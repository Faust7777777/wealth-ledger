# Flutter rewrites these generated files with LF on every Windows build. Force
# checkout to the same representation so package provenance stays clean even
# when the runner's global core.autocrlf setting differs.
windows/flutter/generated_plugin_registrant.cc text eol=lf
windows/flutter/generated_plugin_registrant.h text eol=lf
windows/flutter/generated_plugins.cmake text eol=lf
