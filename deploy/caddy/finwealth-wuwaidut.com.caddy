
wuwaidut.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-X-Powered-By
		Server "caddy"
	}

	@cloudflare {
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	@finwealth {
		path /v1/accounts /v1/accounts/* /v1/agent/* /v1/ai/* /v1/atomic-groups/* /v1/auth/* /v1/categories /v1/categories/* /v1/client-updates/* /v1/counterparties /v1/counterparties/* /v1/dca/* /v1/fx-rates /v1/health /v1/holdings /v1/instruments /v1/instruments/* /v1/ledger/* /v1/movements /v1/movements/* /v1/portfolio/* /v1/quotes /v1/quotes/* /v1/snapshots /v1/snapshots/* /v1/subscriptions /v1/subscriptions/* /v1/sync/*
	}
	@relayManagement path /management.html

	handle @cloudflare {
		handle @relayManagement {
			respond "Not Found" 404
		}

		handle @finwealth {
			reverse_proxy 172.19.0.1:8791 {
				header_up Host {host}
				header_up X-Real-IP {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Forwarded-Host {host}
			}
		}

		handle {
			reverse_proxy cli-proxy-api:8317 {
				header_up Host {host}
				header_up X-Real-IP {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Forwarded-Host {host}
			}
		}
	}

	respond "Forbidden" 403
}
