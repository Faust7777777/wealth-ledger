# Copy to /etc/finwealth/agent.env and chmod 600.
# Use the same random token in server.env; never commit the real value.

FINWEALTH_AGENT_ADDR=127.0.0.1:8792
FINWEALTH_AGENT_INTERNAL_TOKEN=change-me
FINWEALTH_SERVER_BASE_URL=http://127.0.0.1:8790
FINWEALTH_AGENT_STATE_DIR=/var/lib/finwealth-agent
PI_CODING_AGENT_DIR=/var/lib/finwealth-agent/pi
# Explicit selection only. The runtime never falls back to another provider.
FINWEALTH_AGENT_DEFAULT_MODEL_ID=xai/grok-4.5
