# Copy to /etc/finwealth/server.env and chmod 600.
# Do not commit real values.

FINWEALTH_REQUIRE_AUTH=true
FINWEALTH_AUTH_USERNAME=change-me
FINWEALTH_AUTH_PASSWORD_HASH=change-me

# Keep the Rust server loopback-only. Put Caddy/Nginx on 80/443 if exposing it.
FINWEALTH_RS_ADDR=127.0.0.1:8790

# Host header allow-list for the mounted real ledger.
# Keep loopback defaults for local-only use; add your reverse-proxy public host here.
# Example: FINWEALTH_ALLOWED_HOSTS=api.example.com
FINWEALTH_ALLOWED_HOSTS=

# Private default: no outbound quote calls. Set to "yahoo" only after explicit opt-in.
FINWEALTH_QUOTE_PROVIDER=none
